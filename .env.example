# Firebase web config (Firebase console → Project settings → Your apps)
VITE_API_KEY=
VITE_AUTH_DOMAIN=apple-on-the-desk.firebaseapp.com
VITE_PROJECT_ID=apple-on-the-desk
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# API base URL for production builds (dev proxies /api to the local API). Keep the trailing /api/
VITE_API_URL=https://api.example.com/api/

# Marketing site: /Login links here ("New here?", Terms, Privacy). Use the apex domain:
# info.appleonthedesk.co.za serves an invalid certificate.
VITE_INFO_SITE_URL=https://appleonthedesk.co.za

# App URL (optional, defaults to current origin in dev)
# VITE_APP_URL=https://teacher.appleonthedesk.co.za
